---
// All the <head> SEO tags live here so every page gets them right.
import { SITE_TITLE, SITE_OG_IMAGE, SOCIAL_LINKS, CONTACT_EMAIL } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;        // unique per page
  description: string;  // unique per page (shows under the title on Google)
  image?: string;       // social-share preview image
  /** 'website' for normal pages, 'article' for blog posts */
  type?: 'website' | 'article';
}

const { title, description, image = SITE_OG_IMAGE, type = 'website' } = Astro.props;

// Astro.site comes from `site:` in astro.config.mjs. Astro.url is the current page.
// new URL(path, base) turns relative paths into absolute ones, and social sites
// require absolute image/URL paths to render a preview.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Organization schema, sitewide: tells Google (and AI crawlers) who is behind
// the site, with sameAs pointing at our real profiles. This is the E-E-A-T
// "who runs this" signal small brands usually miss.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_TITLE,
  url: new URL('/', Astro.site).toString(),
  logo: new URL('/questling-icon.png', Astro.site).toString(),
  email: CONTACT_EMAIL,
  sameAs: SOCIAL_LINKS.map((s) => s.url),
};

// Speculation Rules: Chrome/Edge prerender the app when a visitor hovers any
// link into /app, so the marketing-to-app jump feels instant in real use.
const speculation = {
  prerender: [{ where: { href_matches: '/app/*' }, eagerness: 'moderate' }],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Primary SEO -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Favicon (the gem) -->
<link rel="icon" type="image/png" href="/questling-icon.png" />
<link rel="apple-touch-icon" href="/questling-icon.png" />
<meta name="theme-color" content="#4f46c7" />

<!-- Open Graph (Facebook, iMessage, Slack, LinkedIn previews) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Who runs this site (E-E-A-T) + instant app prerender on link hover -->
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<script type="speculationrules" set:html={JSON.stringify(speculation)} />

<!-- Fonts: Inter, with preconnect so it loads fast -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- Load the font stylesheet without blocking render: fetch as low-priority
     "print", then flip to "all" once it arrives. The metric-matched Inter
     fallback keeps layout shift tiny during the swap. -->
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
  />
</noscript>

<!-- Google Analytics (G-XM4XPXFTNB), on the marketing site.
     Consent Mode v2 is declared BEFORE gtag('config'), which is the whole
     point: run it the other way round and the first pageview goes out with
     ad storage granted before anything can deny it.
       ad_storage / ad_user_data / ad_personalization  -> denied, always.
         Kills Google Signals and remarketing, so no advertising profile is
         ever built from a site about children's activities. That is what the
         2025 COPPA amendment is aimed at.
       analytics_storage -> denied for Europe/* timezones.
         An analytics cookie is non-essential under GDPR/ePrivacy, which is
         what would force a consent banner. Denied means GA sends cookieless
         pings: the visit still counts, nothing is stored on the device, and
         no banner is needed. Timezone rather than an IP lookup, so there is
         no extra network call and no new identifier, and it fails closed.
     CSP already allows googletagmanager.com and *.google-analytics.com.
     The app under /app reports separately via Firebase (G-M1MM0YV94N). -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  var inEurope = true;
  try { inEurope = /^Europe\//.test(Intl.DateTimeFormat().resolvedOptions().timeZone || ''); } catch (e) {}
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: inEurope ? 'denied' : 'granted',
  });
  gtag('js', new Date());
  gtag('config', 'G-XM4XPXFTNB');
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-XM4XPXFTNB"></script>
